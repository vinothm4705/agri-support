            "duration": "Feb - Mar",
            "desc": "Late winter/Summer sowing. Major season for Sesame and Cotton."
        },
        {
            "name": "Sornavari",
            "duration": "Apr - May",
            "desc": "Summer sowing season (Chithiraipattam). Ideal for millets and cotton."
        },
        {
            "name": "Kuruvai",
            "duration": "Jun - Jul",
            "desc": "Short-term crop season coinciding with the Southwest Monsoon."
        },
        {
            "name": "Samba",
            "duration": "Aug - Sep",
            "desc": "The main long-term rice season. Relies on Northeast Monsoon rains."
        },
        {
            "name": "Thaladi",
            "duration": "Sep - Oct",
            "desc": "Follow-up crop sown in lands where Kuruvai was already harvested."
        },
        {
            "name": "Late Thaladi",
            "duration": "Oct - Nov",
            "desc": "Late planting season during the heavy monsoon period."
        }
    ],
